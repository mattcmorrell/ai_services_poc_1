<script>
  // Run immediately
  removeBadRole();

  // Run again after 1 second (to catch Spara loading)
  setTimeout(removeBadRole, 1000);
  
  // Run again after 3 seconds (just in case Spara is slow)
  setTimeout(removeBadRole, 3000);

  // Set up the permanent guard
  var targetNode = document.querySelector('.g_page--wrap');
  if (targetNode) {
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (targetNode.getAttribute('role') === 'navigation') {
          targetNode.removeAttribute('role');
          console.log("🚫 AccessiBe Fix: Removed bad role added by external script.");
        }
      });
    });
    observer.observe(targetNode, { attributes: true, attributeFilter: ['role'] });
  }

  function removeBadRole() {
    var el = document.querySelector('.g_page--wrap');
    if (el && el.getAttribute('role') === 'navigation') {
      el.removeAttribute('role');
    }
  }
</script></body></html>