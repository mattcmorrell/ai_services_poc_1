.g_rich_text :is(p, ol, ul) {margin-top: var(--spacer--text--m);}
.g_rich_text :is(blockquote) {margin-top: var(--spacer--element--s);margin-bottom: var(--spacer--element--s)}
.w-richtext > *:first-child { margin-top: 0; }
