.is--background_gradient--2_dark{background: radial-gradient(65.86% 89.14% at 100% 0%, rgba(255, 201, 120, 0.17) 0%, rgba(255, 201, 120, 0.00) 100%), radial-gradient(60.11% 86.36% at 0% 0%, rgba(104, 139, 255, 0.17) 0%, rgba(104, 139, 255, 0.00) 100%), radial-gradient(41.31% 34.31% at 49.58% 0%, rgba(255, 113, 253, 0.17) 0%, rgba(255, 113, 253, 0.00) 100%), var(--Color-Surface-2, #1E1A2E);}

.is--highlighted_text--1{-webkit-box-decoration-break: clone;}

